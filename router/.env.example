# router/pihole-dns.py settings. Copy to router/.env (gitignored) and fill in;
# environment variables override these.

# The ZTE MC888 router's web UI address and login.
ROUTER_ADDR=192.168.0.1
ROUTER_USER=user
ROUTER_PASSWORD=

# Pi-hole's address: the server running the stack. `enable` makes the router
# forward all DNS here.
PIHOLE_DNS=192.168.0.8
