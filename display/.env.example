# Where the servers are (the Mac Mini).
INFO_SERVER_ADDR=192.168.0.8:9090
PHOTO_SERVER_ADDR=192.168.0.8:9092
# Which screen each app goes on: DP-1/DP-2/DP-3 on the t530 (see
# /sys/class/drm/card*-DP-*/status for which ones have a screen).
INFO_OUTPUT=DP-1
PHOTO_OUTPUT=DP-2
# Screen rotation, as sway's output transform: normal, 90, 180, 270.
INFO_TRANSFORM=normal
PHOTO_TRANSFORM=normal
TZ=Europe/London
