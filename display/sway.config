# Kiosk: info-gui full screen on INFO_OUTPUT, photo-gui on PHOTO_OUTPUT. No
# bar (there's no bar block), no borders.
include /etc/sway/outputs.config
output * bg #000000 solid_color
default_border none
default_floating_border none
focus_follows_mouse no
seat * hide_cursor 100

# Matched by app_id (the binary's name). assign rather than for_window +
# move, so each window is born on its own screen.
assign [app_id="^info-gui$"] workspace 1
assign [app_id="^photo-gui$"] workspace 2
for_window [app_id="^(info|photo)-gui$"] fullscreen enable
