PUID=1000
PGID=1000
TZ=Etc/UTC
PIHOLE_PASSWORD=changeme

# plex: optional claim token from https://plex.tv/claim (valid ~4 minutes) to
# auto-link the server on first run. Leave empty to claim manually via the
# web UI instead (http://<host>:32400/web).
PLEX_CLAIM=

# nowplaying: renderer's AVTransport control URL + service type — set to
# whatever real device you're pointing at.
RENDERER_CONTROL_URL=
RENDERER_SERVICE_TYPE=urn:schemas-upnp-org:service:AVTransport:1
NOWPLAYING_POLL_INTERVAL_SECONDS=3

# info-server: optional BTC wallet balance in the crypto stream. Leave
# WALLET_BTC_ADDRESS empty to disable this stream entirely — never commit a
# real address here, set it only in your local (gitignored) .env.
WALLET_BTC_ADDRESS=
WALLET_BTC_LABEL=BTC Wallet
