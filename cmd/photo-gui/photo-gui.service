# photo-gui on the Tinker Board's HDMI screen: cage (Wayland kiosk
# compositor) running photo-gui full screen on tty1, as the weather user.
# It takes tty1 in place of info-gui (they conflict), so the board is a
# photo frame while this runs.
#
# Install (as root on the board; the video group, the blank cursor and
# getty@tty1 are set up as for info-gui.service):
#   cp photo-gui.service /etc/systemd/system/
#   echo PHOTO_SERVER_ADDR=<host>:9092 > /etc/default/photo-gui
#   systemctl disable --now info-gui
#   systemctl enable --now photo-gui
#
# Back to the info dashboard:
#   systemctl disable --now photo-gui && systemctl enable --now info-gui
[Unit]
Description=Photo frame (photo-gui under cage)
After=systemd-user-sessions.service seatd.service network-online.target
Wants=seatd.service network-online.target
Conflicts=getty@tty1.service info-gui.service
After=getty@tty1.service

[Service]
User=weather
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=LIBSEAT_BACKEND=seatd
# cage always draws a pointer, even with no mouse attached; this theme's
# cursor is a single transparent pixel.
Environment=XCURSOR_PATH=/usr/local/share/icons XCURSOR_THEME=blank
EnvironmentFile=/etc/default/photo-gui
ExecStart=/usr/bin/cage -- /usr/local/bin/photo-gui -kiosk
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
