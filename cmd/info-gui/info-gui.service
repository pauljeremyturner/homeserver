# info-gui on the Tinker Board's HDMI screen: cage (Wayland kiosk
# compositor) running info-gui full screen on tty1, as the weather user.
#
# Install (as root on the board):
#   cp info-gui.service /etc/systemd/system/
#   echo INFO_SERVER_ADDR=<host>:9090 > /etc/default/info-gui
#   usermod -aG video weather          # seatd's socket is group video
#   systemctl disable getty@tty1       # tty1 belongs to cage now
#   systemctl enable --now info-gui
#
# Fall back to the console TUI dashboard (getty autologin on tty1):
#   systemctl disable --now info-gui && systemctl enable --now getty@tty1
[Unit]
Description=Info dashboard (info-gui under cage)
After=systemd-user-sessions.service seatd.service network-online.target
Wants=seatd.service network-online.target
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
User=weather
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=LIBSEAT_BACKEND=seatd
EnvironmentFile=/etc/default/info-gui
ExecStart=/usr/bin/cage -- /usr/local/bin/info-gui -kiosk
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
